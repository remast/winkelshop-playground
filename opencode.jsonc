{
  "$schema": "https://opencode.ai/config.json",
  // "share": "disabled",
  // "enabled_providers": [
  //   "github-copilot"
  // ],
  "permission": {
    //"webfetch": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "ask"
    },
    "edit": {
      // Allow for agentic flow — .env files remain protected
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny"
    }
    // "bash": {
    //   "*": "ask",
    //    "rm *": "ask"
    // },
    // --- Jira MCP: read allow, write ask ---
    // "jira_*": "ask",
    // "jira_get*": "allow",
    // "jira_search": "allow",
    // "jira_download*": "allow"
  },
  "mcp": {
    "angular-cli": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@angular/cli",
        "mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ]
    },
    "postgres": {
      "type": "local",
      "environment": {
        "DATABASE_URI": "postgresql://winkelshop:harry123@localhost:5432/winkelshop"
      },
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ]
    }
  }
}
