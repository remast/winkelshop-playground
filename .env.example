# Copy this file to .env and fill in the keys for the provider(s) you want to use.
# Only one provider key is required — add whichever you have.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- OpenCode Zen (opencode.ai hosted models) ---
# Get your key at https://opencode.ai/auth after running /connect in the TUI
OPENCODE_API_KEY=

# --- Optional: choose a default model ---
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
